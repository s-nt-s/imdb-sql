SELECT DISTINCT ?imdb ?wiki WHERE {
    ?item wdt:P345 ?k .
    ?v schema:about ?item ;
       schema:isPartOf <https://es.wikipedia.org/> .
    FILTER(REGEX(?k, "^tt[0-9][0-9][0-9]+$"))
    FILTER(REGEX(STR(?v), "^https://es.wikipedia.org/wiki/.*$"))

    BIND(?k AS ?imdb)
    BIND(STR(?v) AS ?wiki)

    # Asegurar que k tiene solo un v
    FILTER(NOT EXISTS {
        ?item2 wdt:P345 ?k .
        ?v2 schema:about ?item2 ;
            schema:isPartOf <https://es.wikipedia.org/> .
        FILTER(REGEX(?k, "^tt[0-9][0-9][0-9]+$"))
        FILTER(REGEX(STR(?v2), "^https://es.wikipedia.org/wiki/.*$"))
        FILTER(?v2 != ?v)
    })

    # Asegurar que v tiene solo un k
    FILTER(NOT EXISTS {
        ?item3 wdt:P345 ?k3 .
        ?v schema:about ?item3 ;
           schema:isPartOf <https://es.wikipedia.org/> .
        FILTER(REGEX(?k3, "^tt[0-9][0-9][0-9]+$"))
        FILTER(REGEX(STR(?v), "^https://es.wikipedia.org/wiki/.*$"))
        FILTER(?k3 != ?k)
    })
}
ORDER BY ?imdb
